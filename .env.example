DATABASE_URL=postgresql+asyncpg://demo:demo@postgres:5432/demo
REDIS_URL=redis://redis:6379/0
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# Local testing: accept UNSIGNED webhook payloads (so Postman works without a Stripe signature)
# and enable the /dev endpoints. NEVER enable this on a public deployment.
DEV_MODE=true

# "docker" starts real tenant containers (worker needs the Docker socket),
# "fake" keeps everything in memory so you can try the flow without Docker access.
PROVISIONER=docker
TENANT_IMAGE=traefik/whoami:latest
TENANT_MEMORY_LIMIT=128m
TENANT_CPU_LIMIT=0.25
